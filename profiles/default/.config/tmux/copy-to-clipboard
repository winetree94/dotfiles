#!/bin/sh

# Prefer the clipboard belonging to the current graphical session.  If none is
# available, consume stdin successfully so tmux can still use OSC 52 and retain
# its own paste buffer (especially useful on remote hosts).
if [ "$(uname -s)" = "Darwin" ] && command -v pbcopy >/dev/null 2>&1; then
    exec pbcopy
elif [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then
    exec wl-copy
elif [ -n "${DISPLAY:-}" ] && command -v xclip >/dev/null 2>&1; then
    exec xclip -selection clipboard -in
elif [ -n "${DISPLAY:-}" ] && command -v xsel >/dev/null 2>&1; then
    exec xsel --clipboard --input
elif command -v clip.exe >/dev/null 2>&1; then
    exec clip.exe
else
    exec sh -c 'cat >/dev/null'
fi
