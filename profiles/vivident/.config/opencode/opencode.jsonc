{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.agents/AGENTS.md"],
  "model": "openai/gpt-5.6-sol-fast",
  "small_model": "openai/gpt-5.6-luna-fast",
  "permission": {
    "*": {
      "*": "allow"
    }
  },
  "disabled_providers": [
    // "openrouter",
    "amazon-bedrock",
    "synthetic",
    "minimax-cn",
    "minimax-cn-coding-plan",
    "minimax",
    "minimax-coding-plan",
    "github-models",
    "github-copilot-enterprise"
  ],
  "provider": {},
  "mcp": {
    "outline": {
      "type": "remote",
      "url": "https://outline.k8s.intranet.moelive.tech/mcp",
      "enabled": true
    }
  },
  "plugin": [],
  "skills": {
    "paths": ["~/.agents/skills"]
  }
}
