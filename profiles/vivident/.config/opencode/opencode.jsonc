{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.agents/AGENTS.md"],
  "model": "minimax-coding-plan/MiniMax-M3",
  "small_model": "minimax-coding-plan/MiniMax-M2.7-highspeed",
  "permission": {
    "*": {
      "*": "allow"
    }
  },
  "disabled_providers": [
    "openrouter",
    "opencode",
    "amazon-bedrock",
    "synthetic",
    "minimax-cn",
    "minimax-cn-coding-plan",
    "minimax",
    "github-models",
    "github-copilot-enterprise"
  ],
  "provider": {},
  "mcp": {
    "outline": {
      "type": "remote",
      "url": "https://outline.k8s.intranet.moelive.tech/mcp",
      "enabled": true
    }
  },
  "plugin": [],
  "skills": {
    "paths": ["~/.agents/skills"]
  }
}
